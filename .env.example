POSTGRES_DB=hrchat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# The app connects as app_user (row-level security applies). Only setup scripts use the admin URL.
DATABASE_URL=postgresql://app_user:app_pass@db:5432/hrchat
ADMIN_DATABASE_URL=postgresql://postgres:postgres@db:5432/hrchat
# Any OpenAI-compatible endpoint. For a server on your own machine use http://host.docker.internal:<port>/v1
# (127.0.0.1 inside the container is the container itself).
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace-me
# Create a free OpenRouter account, generate a key, and use a model marked as free.
# The demo uses the free tier for small trial usage (roughly 50 free requests before limits apply).
# Example: OPENAI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENAI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Keep false: with reasoning on, free models can take minutes and the run times out.
OPENAI_REASONING_ENABLED=false
# Seconds to wait for the model (planning / streamed answer).
LLM_PLAN_TIMEOUT=30
LLM_ANSWER_TIMEOUT=60
